    "folder",
    "jacket",
    "key_in",
    "screen_locked",
    "screen_on",
    "person (готовая модель COCO)",
    "person (pose) — руки/тело, готовая модель позы"
  ],
  "params": {
    "T_cash_idle_s": 15,
    "T_safe_open_s": 8,
    "T_door_open_s": 5,
    "T_unclear_s": 3,
    "_calibration": "порог = max(значение в роликах NO_VIOLATION) × 1.2, но не ниже стартового"
  },
  "algorithms": [
    {
      "id": "A1",
      "name": "Новый человек подошёл к окну",
      "steps": [
        "Предыдущая операция закрыта: на столе нет cash_stack/document, нет safe_open.",
        "Человек передаёт document через окно; кассир держит его и смотрит.",
        "Только после этого начинается движение cash_stack.",
        "Если это инкассатор с cash-in-transit bag — тоже сначала document."
      ]
    },
    {
      "id": "A2",
      "name": "Приём денег от клиента",
      "steps": [
        "document проверен (A1).",
        "cash_stack приходит через окно.",
        "cash_stack проходит через counter.",
        "Если кассир достаёт деньги из counter второй раз — вторая (отбракованная) стопка проверяется у uv_lamp.",
        "Сумма вносится в ноутбук (screen_on, руки у ноутбука).",
        "safe_open → cash_stack в сейф → сейф закрыт.",
        "document возвращён клиенту, стол пуст."
      ]
    },
    {
      "id": "A3",
      "name": "Выдача денег клиенту",
      "steps": [
        "document проверен (A1).",
        "safe_open → cash_stack из сейфа → сейф сразу закрыт.",
        "cash_stack проходит counter на глазах клиента.",
        "cash_stack уходит клиенту через окно целиком.",
        "Запись в ноутбук, document возвращён, стол пуст."
      ]
    },
    {
      "id": "A4",
      "name": "Обмен валюты",
      "steps": [
        "Выполняется A2 (приём), принятые деньги убираются в сейф.",
        "Затем A3 (выдача). Принятая и выдаваемая стопки никогда не лежат вместе."
      ]
    },
    {
      "id": "A5",
      "name": "Уход кассира",
      "steps": [
        "Все cash_stack, document, folder убраны в сейф.",
        "Сейф закрыт (нет safe_open), ключ вынут (нет key_in).",
        "Ноутбук заблокирован (screen_locked).",
        "Кассир берёт/надевает jacket и выходит.",
        "Дверь закрыта (нет door_open)."
      ]
    },
    {
      "id": "A6",
      "name": "Инкассация",
      "steps": [
        "Инкассатор показывает document.",
        "cash-in-transit bag передаётся через окно; кассир осматривает сумку (держит, поворачивает).",
        "Вскрытие — только при инкассаторе.",
        "Содержимое проходит counter, затем в сейф.",
        "Сумка не лежит на столе без присмотра."
      ]
    }
  ],
