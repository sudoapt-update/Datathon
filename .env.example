APP_NAME=ForteBank Cash Discipline
API_KEY=datathon-jury-key-change-me
MAX_UPLOAD_MB=40
JOB_TTL_SEC=3600
DATA_DIR=./data
VIDEO_DIR=C:/Users/User/Downloads/train_videos/videos
LABELS_PATH=./data/labels.json
# All inference must stay local. Do not set cloud LLM endpoints.
LOCAL_ONLY=true
# rules = detector + rules, VLM only rechecks weak hits. labels/hybrid are debug-only.
ANALYZER_MODE=rules
YOLO_WEIGHTS=./yolo11m.pt
RULES_FPS=3
VLM_ENABLED=true
VLM_MODEL_DIR=./models/Qwen3.5-4B
VLM_BUDGET_SEC=90
ANALYZE_BUDGET_SEC=240
FRAME_FPS=2.0
EVIDENCE_JPEG_QUALITY=80
EVIDENCE_MAX_WIDTH=960
EVIDENCE_FRAME_COUNT=3
EVIDENCE_SPAN_SEC=1.0
